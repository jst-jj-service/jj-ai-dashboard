# ==========================================
# AI GATEWAY ENVIRONMENT CONFIGURATION
# ==========================================

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL or SQLite)
# For SQLite (zero-config local dev):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production / docker):
# DATABASE_URL="postgresql://gateway:gateway_pass@localhost:5432/ai_gateway?schema=public"

# Redis (optional, in-memory fallback enabled automatically if omitted or unreachable)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# Upstream Third-Party AI Gateway (The target gateway we proxy requests to)
# e.g., https://api.hzapi.vip (default) or any OpenAI-compatible provider
UPSTREAM_BASE_URL="https://api.hzapi.vip"
UPSTREAM_API_KEY="sk-your-upstream-master-api-key"
UPSTREAM_TIMEOUT_MS=60000

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Shop & Redemption Settings
NEXT_PUBLIC_SHOP_URL="https://your-shop.com"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Initial Admin (Must be changed in production, min 12 chars)
ADMIN_EMAIL="admin@gateway.local"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"
